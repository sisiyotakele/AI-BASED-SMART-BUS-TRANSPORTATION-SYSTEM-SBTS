# ==============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to git!

# ==============================================
# APPLICATION
# ==============================================
NODE_ENV=production
PORT=4000
API_VERSION=v1

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
# IMPORTANT: Replace with your production database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://prod_user:STRONG_PASSWORD_HERE@your-db-host.com:5432/sbts_prod?schema=public

# ==============================================
# JWT SECRETS
# ==============================================
# CRITICAL: Generate strong random secrets (64+ characters)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=GENERATE_64_CHAR_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHAR_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# REDIS (Session & Caching)
# ==============================================
# IMPORTANT: Use production Redis instance
REDIS_URL=redis://default:PASSWORD@your-redis-host.com:6379

# ==============================================
# AI SERVICE
# ==============================================
# IMPORTANT: Update with production AI service URL
AI_SERVICE_URL=https://ai.yourdomain.com

# ==============================================
# CORS
# ==============================================
# IMPORTANT: Set to your production frontend domain
CORS_ORIGIN=https://yourdomain.com

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# LOGGING & MONITORING
# ==============================================
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==============================================
# SECURITY
# ==============================================
# IMPORTANT: Set to true for production
ENABLE_HTTPS=true
SECURE_COOKIES=true

# ==============================================
# FILE UPLOADS (if applicable)
# ==============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/uploads

# ==============================================
# EMAIL (if applicable)
# ==============================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=SBTS <noreply@yourdomain.com>
