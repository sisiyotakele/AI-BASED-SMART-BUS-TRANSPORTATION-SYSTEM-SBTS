PORT=4000
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sbts?schema=public"
JWT_SECRET=change-me
AI_SERVICE_URL=http://localhost:5000
SOCKET_ENABLED=true

# Password reset email (use Gmail app password, SendGrid SMTP, Mailgun, etc.)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
PASSENGER_APP_URL=http://localhost:5175
TEST_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sbts"

# Sentry Error Monitoring (optional)
SENTRY_ENABLED=false
SENTRY_DSN=

